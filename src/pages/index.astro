---
import Base from '@/layouts/Base.astro'
import Me from '@/components/home/Me.astro'
import Contact from '@/components/home/Contact'
import ContactInfo from '@/components/home/ContactInfo'
import Section from '@/components/Section.astro'
import ProjectCard from '@/components/ProjectCard.astro'

const organizations = [
  { name: 'Tecnova', src: '/images/organizations/tecnova.svg' },
  { name: 'Masapp', src: '/images/organizations/masapp.svg' },
  { name: 'Ferrara', src: '/images/organizations/ferrara.svg' },
  { name: 'Fortclub', src: '/images/organizations/fortclub.svg' },
  { name: 'Jobsa', src: '/images/organizations/jobsa.svg' },
  { name: 'Naturisa', src: '/images/organizations/naturisa.svg' },
  { name: 'VG Courier', src: '/images/organizations/vgcourier.svg' }
]

const projects = [
  {
    title: 'Memmorable',
    subtitle: 'Invitaciones digitales para organizar eventos sin fricción.',
    secretTitle: 'Memmorable - Invitaciones digitales con RSVP para eventos',
    domain: 'memmorable.com',
    href: 'https://memmorable.com',
    logoUrl: '/images/projects/memmorable.svg',
    imageUrl: '/images/projects/memmorable-home.png',
    metric: '+300 invitaciones enviadas'
  },
  {
    title: 'Deplatos',
    subtitle: 'Menús digitales y links públicos para restaurantes.',
    secretTitle: 'DePlatos - Menús digitales y links para restaurantes',
    domain: 'deplatos.com',
    logoUrl: '/images/projects/deplatos.svg',
    imageUrl: '/images/projects/deplatos-home.png',
    href: 'https://deplatos.com'
  },
  {
    title: 'Calculadora UG',
    subtitle: 'Simula y calcula calificaciones para estudiantes Universidad de Guayaquil.',
    secretTitle: 'Calculadora UG - Simulador de calificaciones para estudiantes',
    domain: 'calculadoraug.com',
    href: 'https://calculadoraug.asanlucas.com',
    logoUrl: '/images/projects/calculadoraug.svg',
    imageUrl: '/images/projects/calculadoraug.png',
    metric: '+20k visitas por semestre'
  },
  {
    title: 'Lumo',
    subtitle: 'Notas y pendientes para mantener claridad diaria.',
    secretTitle: 'Lumo - Aplicación de notas para productividad y claridad',
    domain: 'lumoclarity.com',
    href: 'https://lumoclarity.com',
    logoUrl: '/images/projects/lumo_favicon.svg',
    imageUrl: '/images/projects/lumoclarity-home.png'
  }
]
---

<Base
  titlePage="Anthony San Lucas"
  descriptionPage="Desarrollador de software en Guayaquil, Ecuador. Creo productos digitales web y móviles para personas y negocios."
  currentUrl="">
  <div
    class="absolute inset-0 -z-10 h-full w-full bg-white bg-[linear-gradient(to_right,#8080800a_1px,transparent_1px),linear-gradient(to_bottom,#8080800a_1px,transparent_1px)] bg-[size:14px_24px]">
  </div>

  <section class="flex flex-col lg:flex-row lg:items-start pb-16">
    <Me />

    <section class="w-full min-w-0 lg:ml-12 lg:flex-1">
      <Section title="Empresas y organizaciones con las que he colaborado">
        <article class="flex flex-wrap items-center justify-start gap-4 sm:gap-6">
          {
            organizations.map(org => (
              <div
                class="flex h-20 w-full sm:w-40 items-center justify-center rounded-xl border border-gray-200 bg-white px-4 shadow-sm transition hover:bg-slate-50"
                title={org.name}>
                <img
                  src={org.src}
                  alt={`Logo de ${org.name}`}
                  class="h-10 w-full object-contain"
                  loading="lazy"
                />
              </div>
            ))
          }
        </article>
      </Section>

      <Section title="Mis aplicaciones">
        <div class="relative">
          <div
            class="apps-scroller -mx-4 flex snap-x snap-mandatory scroll-px-4 gap-6 overflow-x-auto px-4 pt-1 sm:-mx-6 sm:scroll-px-6 sm:gap-10 sm:px-6"
            aria-label="Aplicaciones desarrolladas por Anthony San Lucas">
            {projects.map(p => <ProjectCard {...p} />)}
          </div>
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-y-0 -right-6 hidden w-16 bg-gradient-to-l from-white via-white/80 to-transparent sm:block">
          </div>
        </div>
      </Section>

      <Section title={'Información de contacto'}>
        <ContactInfo client:idle />
        <Contact />
      </Section>
    </section>
  </section>
</Base>

<style>
  .apps-scroller {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .apps-scroller::-webkit-scrollbar {
    display: none;
  }
</style>
