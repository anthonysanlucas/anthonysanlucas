---
type Props = {
  title: string
  subtitle: string
  secretTitle?: string
  domain: string
  href: string
  logoUrl?: string
  imageUrl?: string
  isSkeleton?: boolean
  metric?: string
}

const {
  title,
  secretTitle,
  href,
  imageUrl,
  subtitle,
} = Astro.props

const initial = title[0]
const titleId = `${title.toLowerCase().replaceAll(' ', '-')}-title`
---

<article
  aria-labelledby={titleId}
  class="group relative w-[min(82vw,30rem)] flex-none snap-start">
  <a
    href={href}
    target="_blank"
    rel="noreferrer"
    class="block rounded-t-2xl outline-none focus-visible:ring-2 focus-visible:ring-gray-900 focus-visible:ring-offset-4"
    aria-label={`Ver ${title}`}>
    <div class="relative aspect-[16/9] overflow-hidden rounded-t-2xl border border-gray-200 bg-slate-50 shadow-sm transition-colors duration-300 group-hover:bg-slate-100 motion-reduce:transition-none">
      {imageUrl ? (
        <div class="absolute inset-x-[11%] -bottom-2 top-[11%] overflow-hidden rounded-t-lg bg-white shadow-[0_1px_2px_rgba(15,23,42,0.04),0_12px_32px_-12px_rgba(15,23,42,0.16)] ring-1 ring-gray-200 transition duration-500 group-hover:-translate-y-1.5 group-focus-within:-translate-y-1.5 motion-reduce:transition-none">
          <img
            src={imageUrl}
            alt={`Vista previa de ${title}`}
            class="h-full w-full object-cover object-top"
            loading="lazy"
          />
        </div>
      ) : (
        <div class="flex h-full items-center justify-center">
          <span class="text-4xl font-bold text-gray-300">{initial}</span>
        </div>
      )}
      <span class="sr-only">Abrir {title} en una nueva pestaña</span>
    </div>
  </a>

  <div class="px-1 pt-5">
    <h3 id={titleId} class="text-base font-semibold text-gray-900">
      {title}
    </h3>
    {secretTitle && <span class="sr-only">{secretTitle}</span>}
    <p class="mt-1 max-w-[26rem] text-sm leading-6 text-gray-500">
      {subtitle}
    </p>
  </div>
</article>
