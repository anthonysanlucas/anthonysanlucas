---
type Props = {
  title: string
  subtitle: string
  secretTitle?: string
  domain: string
  href: string
  logoUrl?: string
  imageUrl?: string
  isSkeleton?: boolean
  badge?: string
  highlights?: string[]
  instagramHref?: string
  ctaLabel?: string
}

const {
  title,
  subtitle,
  secretTitle,
  domain,
  href,
  logoUrl,
  imageUrl,
  badge,
  highlights,
  instagramHref,
  ctaLabel,
} = Astro.props

const cta = ctaLabel ?? 'Ver proyecto'
const initial = title[0]
const allTags = [...(highlights ?? []), ...(badge ? [badge] : [])]
---

<article class="group rounded-3xl border border-gray-200/80 bg-white shadow-sm overflow-hidden transition-all duration-300 hover:-translate-y-0.5 hover:border-gray-300 hover:shadow-[0_8px_32px_rgba(0,0,0,0.08)]">
  <div class="flex flex-col sm:flex-row">

    <!-- Left: content -->
    <div class="flex-1 min-w-0 p-6 sm:p-7 flex flex-col gap-4">

      <div class="flex items-center gap-3">
        <div class="h-10 w-10 shrink-0 rounded-full border border-gray-200 bg-gray-100 overflow-hidden flex items-center justify-center">
          {logoUrl ? (
            <img src={logoUrl} alt={`${title} logo`} class="h-full w-full object-cover" loading="lazy" />
          ) : (
            <span class="text-sm font-bold text-gray-400">{initial}</span>
          )}
        </div>
        <div>
          <p class="text-sm font-bold leading-tight text-gray-900">{title}</p>
          <p class="text-xs text-gray-400 mt-0.5">{domain}</p>
        </div>
      </div>

      <p class="text-sm leading-[1.7] text-gray-600">{subtitle}</p>

      {allTags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {allTags.map((tag) => (
            <span class="inline-flex items-center rounded-full bg-gray-50 border border-gray-200 px-2.5 py-0.5 text-[11px] font-medium text-gray-500">
              {tag}
            </span>
          ))}
        </div>
      )}

      <!-- CTA: desktop only -->
      <div class="hidden sm:flex items-center gap-2.5 mt-auto pt-1">
        <a
          href={href}
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center gap-1.5 rounded-lg bg-gray-900 px-4 py-2 text-xs font-semibold text-white transition-colors hover:bg-gray-700">
          {cta}
          <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17L17 7"/><path d="M7 7h10v10"/>
          </svg>
        </a>
        {instagramHref && (
          <a
            href={instagramHref}
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center gap-1.5 rounded-lg border border-gray-200 bg-white px-4 py-2 text-xs font-medium text-gray-600 transition hover:border-gray-300 hover:bg-gray-50">
            Instagram
          </a>
        )}
      </div>

      {secretTitle && <h3 class="sr-only">{secretTitle}</h3>}
    </div>

    <!-- Right: preview panel -->
    <div class="h-[220px] sm:h-auto sm:w-[44%] sm:shrink-0 flex flex-col bg-gradient-to-br from-gray-50 to-slate-50/80">
      <div class="flex-1 p-4 sm:p-5 flex flex-col">
        <div class="flex-1 rounded-xl overflow-hidden border border-gray-200/60 shadow-[0_8px_28px_rgba(0,0,0,0.09),_0_2px_6px_rgba(0,0,0,0.04)] transition-transform duration-500 group-hover:scale-[1.015]">
          {imageUrl ? (
            <img
              src={imageUrl}
              alt={`${title} preview`}
              class="h-full w-full object-cover object-top"
              loading="lazy"
            />
          ) : (
            <div class="h-full flex flex-col items-center justify-center gap-2 bg-gray-50">
              <span class="text-4xl font-bold text-gray-200">{initial}</span>
              <span class="text-[10px] text-gray-300">{domain}</span>
            </div>
          )}
        </div>
      </div>
    </div>

  </div>

  <!-- CTA: mobile only -->
  <div class="sm:hidden flex items-center gap-2.5 px-6 pb-6 pt-1">
    <a
      href={href}
      target="_blank"
      rel="noreferrer"
      class="inline-flex items-center gap-1.5 rounded-lg bg-gray-900 px-4 py-2 text-xs font-semibold text-white transition-colors hover:bg-gray-700">
      {cta}
      <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M7 17L17 7"/><path d="M7 7h10v10"/>
      </svg>
    </a>
    {instagramHref && (
      <a
        href={instagramHref}
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center gap-1.5 rounded-lg border border-gray-200 bg-white px-4 py-2 text-xs font-medium text-gray-600 transition hover:border-gray-300 hover:bg-gray-50">
        Instagram
      </a>
    )}
  </div>
</article>
