---
type Props = {
  title: string
  subtitle: string
  secretTitle?: string
  domain: string
  href: string
  logoUrl?: string
  imageUrl?: string
  isSkeleton?: boolean
  metric?: string
}

const {
  title,
  secretTitle,
  domain,
  href,
  imageUrl,
  metric,
} = Astro.props

const initial = title[0]
const titleId = `${title.toLowerCase().replaceAll(' ', '-')}-title`
---

<article
  data-project-card
  data-revealed="false"
  aria-labelledby={titleId}
  class="group relative overflow-hidden rounded-[1.5rem] border border-gray-200/80 shadow-sm outline-none transition-all duration-300 hover:-translate-y-0.5 hover:border-gray-300 hover:shadow-[0_18px_50px_rgba(15,23,42,0.08)] focus-within:ring-2 focus-within:ring-gray-900/20">
  <a
    data-project-card-link
    href={href}
    target="_blank"
    rel="noreferrer"
    class="relative block aspect-[4/3] overflow-hidden bg-[linear-gradient(135deg,#f8fafc_0%,#f9fafb_48%,#eef2ff_100%)] sm:aspect-[16/11]"
    aria-label={`Ver ${title}`}>
    {imageUrl ? (
      <img
        src={imageUrl}
        alt={`${title} preview`}
        class="h-full w-full object-contain p-4 drop-shadow-[0_18px_30px_rgba(15,23,42,0.14)] transition duration-700 group-hover:scale-[1.025] group-focus:scale-[1.025] group-focus-within:scale-[1.025] group-data-[revealed=true]:scale-[1.025] sm:p-6"
        loading="lazy"
      />
    ) : (
      <div class="flex h-full flex-col items-center justify-center gap-2 bg-gray-50">
        <span class="text-5xl font-bold text-gray-200">{initial}</span>
        <span class="text-xs text-gray-300">{domain}</span>
      </div>
    )}

    {metric && (
      <div class="pointer-events-none absolute inset-x-4 top-4 flex -translate-y-1 justify-center opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:translate-y-0 group-focus-within:opacity-100 group-data-[revealed=true]:translate-y-0 group-data-[revealed=true]:opacity-100 sm:top-5">
        <span class="rounded-full border border-emerald-200/60 bg-emerald-50/85 px-3 py-1.5 text-[11px] font-medium leading-none text-emerald-700 shadow-[0_8px_20px_rgba(16,185,129,0.1)] backdrop-blur-sm">
          {metric}
        </span>
      </div>
    )}

    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-white/70 via-white/35 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-within:opacity-100 group-data-[revealed=true]:opacity-100"></div>

    <div class="pointer-events-none absolute inset-x-4 bottom-4 flex translate-y-2 justify-center opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:translate-y-0 group-focus-within:opacity-100 group-data-[revealed=true]:translate-y-0 group-data-[revealed=true]:opacity-100 sm:bottom-5">
      <span class="inline-flex max-w-[82%] min-w-0 items-center gap-2 rounded-full border border-white/70 bg-white/70 px-3 py-2 text-xs font-medium text-gray-900 shadow-[0_10px_24px_rgba(15,23,42,0.07)] backdrop-blur-md sm:px-4">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 17L17 7"/><path d="M7 7h10v10"/>
        </svg>
        <span class="truncate">{domain}</span>
      </span>
    </div>
  </a>

  <h3 id={titleId} class="sr-only">{title}</h3>
  {secretTitle && <h3 class="sr-only">{secretTitle}</h3>}
</article>

<script>
  const touchProjectCardQuery = window.matchMedia('(hover: none), (pointer: coarse)')

  const closeRevealedProjectCards = (activeCard) => {
    document.querySelectorAll('[data-project-card][data-revealed="true"]').forEach((card) => {
      if (card !== activeCard) {
        card.setAttribute('data-revealed', 'false')
      }
    })
  }

  document.addEventListener('click', (event) => {
    if (!touchProjectCardQuery.matches || !(event.target instanceof Element)) return

    const link = event.target.closest('[data-project-card-link]')

    if (!link) {
      closeRevealedProjectCards()
      return
    }

    const card = link.closest('[data-project-card]')
    if (!(card instanceof HTMLElement)) return

    if (card.dataset.revealed !== 'true') {
      event.preventDefault()
      closeRevealedProjectCards(card)
      card.dataset.revealed = 'true'
    }
  })
</script>
